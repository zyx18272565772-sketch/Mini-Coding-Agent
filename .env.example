# 必填：Anthropic API 密钥，或兼容 Anthropic 接口的服务密钥。
ANTHROPIC_API_KEY=

# 必填：你的账号或接口支持的模型名称。
MODEL_ID=

# 可选：自定义接口地址，必须支持 Anthropic Messages API 协议。
# 仅支持 OpenAI Chat Completions 协议的地址不能直接用于此处。
# ANTHROPIC_BASE_URL=https://your-provider.example

# 可选：GitHub MCP，只读查询仓库、Issue 和 PR。默认关闭。
GITHUB_MCP_ENABLED=false
# 令牌仅填写到本地 .env 或环境变量，不要提交或发送到聊天。
GITHUB_MCP_TOKEN=
# 可选：缩小工具范围，使用英文逗号分隔；省略则加载七个受支持的只读工具。
# GITHUB_MCP_TOOLS=search_repositories,get_file_contents,search_code,list_issues,issue_read,list_pull_requests,pull_request_read

# 存储：file 沿用本地文件；mysql 使用数据库，失败不会自动退回文件。
# 完整初始化和旧数据导入步骤见 docs/mysql.md。
STORAGE_BACKEND=file
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mini_coding_agent
MYSQL_USER=mini_agent
# 只填写本机 MySQL 账号的密码，不是模型 API 密钥或 GitHub 令牌。
MYSQL_PASSWORD=

